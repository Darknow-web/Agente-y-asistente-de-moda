# ============================================================
#  SASTRA — variables de entorno del SERVIDOR (nunca en el cliente)
#  En local: copia este archivo a .env. En AI Studio: pestaña Secrets.
#  Solo estas tres hacen falta para arrancar; el resto es opcional.
# ============================================================

# Correos con permiso de administrar la lista de invitados (separados por coma)
ADMIN_EMAILS=

# Secreto que protege las tareas programadas (/api/jobs/*). Cualquier texto largo y aleatorio.
JOBS_SECRET=

# real = llama a los motores de IA · simulado = responde sin gastar (para desarrollar)
MOTOR_MODO=real

# ------------------------------------------------------------
#  Opcionales (quita el # para usarlas)
# ------------------------------------------------------------

# Llave de Gemini. En AI Studio la pone la plataforma sola (GEMINI_API_KEY o API_KEY);
# en local o en Cloud Run directo, créala en aistudio.google.com/apikey.
# GEMINI_API_KEY=

# Llave de Claude (console.anthropic.com). Si falta, todo usa Gemini.
# ANTHROPIC_API_KEY=

# Sobrescribir el motor de un agente sin tocar código. Formato: proveedor:modelo
# Ejemplos: MOTOR_ESTILISMO=claude:claude-sonnet-5-5   MOTOR_CALIDAD=gemini:pro
# MOTOR_DIRECTOR=
# MOTOR_GUARDARROPA=
# MOTOR_ESTILISMO=
# MOTOR_PLANIFICACION=
# MOTOR_CUIDADO=
# MOTOR_COMPRAS=
# MOTOR_PROBADOR=
# MOTOR_CALIDAD=

# Firebase: NO hace falta rellenarlo. La integración de AI Studio escribe firebase-applet-config.json
# en la raíz y la app (cliente y servidor) lo lee de ahí. Estas variables solo sirven para forzar
# otro proyecto y, si se rellenan, mandan sobre ese archivo.
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIRESTORE_DATABASE_ID=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Notificaciones push (opcionales). Genera las claves con `npm run push:claves` y pégalas aquí o en Secrets.
# Sin ellas, los avisos solo se ven dentro de la app.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Puerto del servidor (Cloud Run y AI Studio lo definen solos)
# PORT=8080
