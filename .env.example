# ============================================================
#  SASTRA — variables de entorno del SERVIDOR (nunca en el cliente)
#  Copia este archivo a .env y completa lo que uses.
# ============================================================

# Motor principal: llave de Gemini creada en Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=

# Motor opcional: llave de Claude (console.anthropic.com). Si está vacía, todo usa Gemini.
ANTHROPIC_API_KEY=

# Sobrescribir el motor de un agente sin tocar código. Formato: proveedor:modelo
# Ejemplos: MOTOR_ESTILISMO=claude:claude-sonnet-5-5   MOTOR_CALIDAD=gemini:pro
# MOTOR_DIRECTOR=
# MOTOR_GUARDARROPA=
# MOTOR_ESTILISMO=
# MOTOR_PLANIFICACION=
# MOTOR_CUIDADO=
# MOTOR_COMPRAS=
# MOTOR_PROBADOR=
# MOTOR_CALIDAD=

# Modo simulado: la app responde sin llamar a ningún motor (para desarrollar sin gastar)
MOTOR_MODO=real

# Correos con permiso de administrar la lista de invitados (separados por coma)
ADMIN_EMAILS=

# Secreto que protege las tareas programadas (/api/jobs/*). Cualquier texto largo y aleatorio.
JOBS_SECRET=

# Proyecto de Firebase (normalmente lo rellena AI Studio o Cloud Run automáticamente)
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Si Firestore fue creado por AI Studio, tiene nombre propio (lo escribe la integración). Vacío = base "(default)".
FIRESTORE_DATABASE_ID=

# Puerto del servidor (Cloud Run lo define solo)
PORT=8080

# ============================================================
#  Variables del CLIENTE (prefijo VITE_). Son públicas por diseño.
#  Las genera la integración de Firebase en AI Studio o se copian de la consola de Firebase.
# ============================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
