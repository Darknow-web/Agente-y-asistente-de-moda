rules_version = '2';
// SASTRA — reglas de Firestore (fuente de verdad; no dejar que herramientas las sobrescriban)
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario puede LEER solo sus propios datos y no puede escribir nada directamente.
    // Todas las escrituras pasan por el servidor (Admin SDK, que no está sujeto a estas reglas), que valida
    // la sesión, el plan y los límites. Si el cliente pudiera escribir aquí, podría borrar su contador de
    // mensajes, alterar su consumo o darse un plan de pago escribiendo su propia suscripción.
    match /users/{uid}/{documento=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Lista de cortesías (antes "invitados"): cualquier usuario autenticado puede comprobar si su correo está;
    // solo el servidor (Admin SDK) la modifica.
    match /allowlist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // Todo lo demás (reclamaciones, colecciones internas), cerrado al cliente.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
