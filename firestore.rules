rules_version = '2';
// SASTRA — reglas de Firestore (fuente de verdad; no dejar que herramientas las sobrescriban)
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo ve y edita sus propios datos.
    match /users/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lista de invitados: cualquier usuario autenticado puede comprobar si su correo está;
    // solo el servidor (Admin SDK) la modifica.
    match /allowlist/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // Todo lo demás, cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
