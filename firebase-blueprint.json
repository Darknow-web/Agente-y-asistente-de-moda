{
  "entities": {
    "Perfil": {
      "title": "Perfil",
      "description": "Perfil y preferencias del usuario",
      "type": "object",
      "properties": {
        "nombre": { "type": "string" },
        "genero": { "type": "string", "enum": ["mujer", "hombre", "otro", "prefiero-no-decir"] },
        "ciudad": { "type": "string" },
        "pais": { "type": "string" },
        "lat": { "type": "number" },
        "lon": { "type": "number" },
        "presupuestoMensual": { "type": "number" },
        "moneda": { "type": "string" },
        "creadoEn": { "type": "string", "format": "date-time" },
        "actualizadoEn": { "type": "string", "format": "date-time" }
      }
    },
    "Prenda": {
      "title": "Prenda",
      "description": "Prenda de ropa en el guardarropa del usuario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "categoria": { "type": "string" },
        "subtipo": { "type": "string" },
        "estado": { "type": "string" },
        "usosDesdeLavado": { "type": "number" },
        "usosMaxAntesDeLavar": { "type": "number" },
        "fotoUrl": { "type": "string" },
        "creadaEn": { "type": "string", "format": "date-time" },
        "actualizadaEn": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nombre", "categoria", "estado", "creadaEn", "actualizadaEn"]
    },
    "Uso": {
      "title": "Uso",
      "description": "Registro de uso de una prenda",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "prendaId": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "contexto": { "type": "string" }
      },
      "required": ["id", "prendaId", "fecha"]
    },
    "PlanSemanal": {
      "title": "PlanSemanal",
      "description": "Plan semanal de estilismo generado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "semanaInicio": { "type": "string" },
        "generadoPor": { "type": "string" },
        "creadoEn": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "semanaInicio", "generadoPor", "creadoEn"]
    },
    "Deseo": {
      "title": "Deseo",
      "description": "Artículo de compra deseado",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "prioridad": { "type": "string", "enum": ["alta", "media", "baja"] },
        "creadoEn": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nombre", "prioridad", "creadoEn"]
    },
    "Conversacion": {
      "title": "Conversacion",
      "description": "Sesión de conversación entre usuario y agentes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "resumen": { "type": "string" },
        "actualizadaEn": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actualizadaEn"]
    },
    "Aviso": {
      "title": "Aviso",
      "description": "Aviso o notificación del sistema o agentes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string" },
        "titulo": { "type": "string" },
        "cuerpo": { "type": "string" },
        "leido": { "type": "boolean" },
        "creadoEn": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tipo", "titulo", "cuerpo", "leido", "creadoEn"]
    },
    "RegistroUso": {
      "title": "RegistroUso",
      "description": "Registro de tokens y costos por agente",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agente": { "type": "string" },
        "proveedor": { "type": "string" },
        "modelo": { "type": "string" },
        "tokensEntrada": { "type": "number" },
        "tokensSalida": { "type": "number" },
        "costoEstimadoUsd": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "agente", "proveedor", "modelo", "tokensEntrada", "tokensSalida", "costoEstimadoUsd", "fecha"]
    },
    "Allowlist": {
      "title": "Allowlist",
      "description": "Entrada de allowlist para control de acceso",
      "type": "object",
      "properties": {
        "activo": { "type": "boolean" },
        "creadoEn": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{uid}/perfil/datos": {
      "schema": { "$ref": "#/entities/Perfil" },
      "description": "Perfil del usuario con estilo, medidas y presupuesto"
    },
    "/users/{uid}/prendas/{prendaId}": {
      "schema": { "$ref": "#/entities/Prenda" },
      "description": "Prendas del armario del usuario"
    },
    "/users/{uid}/usos/{usoId}": {
      "schema": { "$ref": "#/entities/Uso" },
      "description": "Registro de uso de prendas"
    },
    "/users/{uid}/planes/{planId}": {
      "schema": { "$ref": "#/entities/PlanSemanal" },
      "description": "Planes semanales de looks"
    },
    "/users/{uid}/deseos/{deseoId}": {
      "schema": { "$ref": "#/entities/Deseo" },
      "description": "Lista de deseos y compras planificadas"
    },
    "/users/{uid}/conversaciones/{conversacionId}": {
      "schema": { "$ref": "#/entities/Conversacion" },
      "description": "Historial de conversaciones con los agentes de SASTRA"
    },
    "/users/{uid}/avisos/{avisoId}": {
      "schema": { "$ref": "#/entities/Aviso" },
      "description": "Notificaciones y avisos automáticos"
    },
    "/users/{uid}/uso/{usoId}": {
      "schema": { "$ref": "#/entities/RegistroUso" },
      "description": "Registro de consumo de tokens y modelos por agente"
    },
    "/allowlist/{email}": {
      "schema": { "$ref": "#/entities/Allowlist" },
      "description": "Lista de correos autorizados"
    }
  }
}
